{
  "id": "migrateDrauvenAspects",
  "info": {
    "dataVersion": 1,
    "sourceFile": "migrations/Issue-498_DrauvenAspectsMigration",
    "modId": "wildermyth-drauven-pcs",
    "author": "Ironskink",
    "STUB": "Breaks the 'human' aspect into multiple aspects for each separate area of concern."
  },
  "type": "ABILITIES_CHANGED",
  "targets": [
    {
      "template": "SELF",
      "aspectValues": [],
      "test": "GREATER_THAN_OR_EQUAL_TO",
      "a": "1-(((heroicActions*drauvenInterfusionRecipes)*drauvenDifficultyModifiers)*drauvenBaseStats)",
      "b": "1"
    }
  ],
  "outcomes": [
    {
      "class": "AddHistory",
      "target": "self",
      "inlineHistory": {
        "id": "drauvenAspectsMigration",
        "associatedAspects": [
          "drauvenInterfusionRecipes",
          "heroicActions",
          "drauvenDifficultyModifiers",
          "issue498DrauvenMigrationRan"
        ],
        "removeAspects": [
          "trueHuman",
          "humanBaseStats",
          "humanVoice",
          "basicInterfusionRecipes"
        ],
        "persistOverLegacy": "never",
        "showInSummary": false
      }
    },
    {
      "class": "Test",
      "threshold": "1",
      "value": "drauvenMale + drauvenFemale - (100 * drauven_pc)",
      "onPass": {
        "class": "DoAll",
        "outcomes": [
          { "class": "ApplyTheme", "target": "hero", "theme": "drauven", "piece": "species" },
          {
            "class": "AddHistory",
            "target": "self",
            "addHistory": [ ["drauvenBaseFIX"] ]
          },
          {
            "class": "CustomizeHero",
            "target": "hero",
            "randomizeSlots": [
              "zzz_drauven01_Head",
              "zzz_drauven02_Feathers",
              "zzz_drauven03_Horns",
              "zzz_drauven04_Whiskers",
              "zzz_drauven05_Helmet",
              "zzz_drauven06_Armour"
            ],
            "randomizeColors": [ "skin" ]
          },
          {
            "class": "Test",
            "threshold": "1",
            "value": "drauvenBaseStats",
            "onFail": {
              "class": "AddHistory",
              "target": "self",
              "inlineHistory": {
                "id": "drauvenAspectsMigration.2",
                "associatedAspects": [
                  "drauvenBaseStats"
                ],
                "showInSummary": false
              }
            }
          }
        ]
      }
    },
    {
      "class": "BranchAbility",
      "target": "self",
      "branchAbility": "applyDifficultyModifiers"
    },
    {
      "class": "BranchAbility",
      "branchAbility": "drauven_setAgingStats",
      "target": "self"
    }
  ]
}